# Copy to .env and fill in. Never commit .env.

# Smartschool: your child's username + YOUR (parent) password
SMARTSCHOOL_USERNAME=
# Use single quotes if it contains # or spaces, e.g. SMARTSCHOOL_PASSWORD='my#pass'
SMARTSCHOOL_PASSWORD=
# Just the host, without https://, e.g. myschool.smartschool.be
SMARTSCHOOL_MAIN_URL=
# Either a birthday (YYYY-MM-DD, no other text) or a Google Authenticator secret
SMARTSCHOOL_MFA=

# Telegram (see README: "Create the Telegram bot")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: 80 mm ESC/POS network receipt printer, "host" or "host:port" (default port 9100).
# When set, the report is also printed.
PRINTER_ADDRESS=
# Optional: TTF font files for the receipt (defaults: DejaVu Sans / Liberation Sans / Arial if found)
PRINTER_FONT=
PRINTER_FONT_BOLD=
